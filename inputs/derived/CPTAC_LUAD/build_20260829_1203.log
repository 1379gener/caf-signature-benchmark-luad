  总行数: 309

     1| ##############################################################################
     2| # Script: 12_cptac_survival_validation.R
     3| # Purpose: SCANI survival validation in CPTAC-LUAD (RNA-seq, same platform
     4| #          as TCGA discovery cohort → no platform mismatch)
     5| # Data:    ~/caf_spatial_project/data/CPTAC_LUAD/
     6| # Output:  ~/caf_spatial_project/results/12_CPTAC_survival/
     7| ##############################################################################
     8| 
     9| library(survival)
    10| library(survminer)
    11| library(GSVA)
    12| library(ggplot2)
    13| library(dplyr)
    14| library(timeROC)
    15| 
    16| set.seed(42)
    17| 
    18| PROJECT_DIR <- "~/caf_spatial_project"
    19| OUT_DIR     <- file.path(PROJECT_DIR, "results/12_CPTAC_survival")
    20| dir.create(OUT_DIR, recursive = TRUE, showWarnings = FALSE)
    21| 
    22| ##############################################################################
    23| # 1. Load data
    24| ##############################################################################
    25| message("=== Step 1: Load CPTAC data ===")
    26| 
    27| expr <- read.csv(
    28|   file.path(PROJECT_DIR, "data/CPTAC_LUAD/expr_matrix.csv"),
    29|   row.names = 1, check.names = FALSE, stringsAsFactors = FALSE
    30| )
    31| message("  Expression matrix: ", nrow(expr), " genes x ", ncol(expr), " samples")
    32| message("  Value range: ", round(min(expr, na.rm=TRUE), 3),
    33|         " to ", round(max(expr, na.rm=TRUE), 3))
    34| 
    35| os_raw <- read.csv(
    36|   file.path(PROJECT_DIR, "data/CPTAC_LUAD/os_data.csv"),
    37|   stringsAsFactors = FALSE
    38| )
    39| message("  OS raw rows: ", nrow(os_raw))
    40| message("  OS columns: ", paste(colnames(os_raw), collapse = ", "))
    41| 
    42| # Clinical for stage/age
    43| clin_raw <- read.csv(
    44|   file.path(PROJECT_DIR, "data/CPTAC_LUAD/clinical_raw.csv"),
    45|   stringsAsFactors = FALSE
    46| )
    47| message("  Clinical attributes: ",
    48|         paste(head(unique(clin_raw$clinicalAttributeId), 20), collapse = ", "))
    49| 
    50| ##############################################################################
    51| # 2. Build clinical table
    52| ##############################################################################
    53| message("=== Step 2: Build clinical table ===")
    54| 
    55| # Deduplicate OS: keep row with longer follow-up per patient
    56| os <- os_raw %>%
    57|   dplyr::group_by(patientId) %>%
    58|   dplyr::slice_max(OS_months, n = 1, with_ties = FALSE) %>%
    59|   dplyr::ungroup() %>%
    60|   dplyr::select(patientId, OS_months, OS_event) %>%
    61|   dplyr::filter(!is.na(OS_months), OS_months > 0)
    62| 
    63| message("  Patients after OS dedup: ", nrow(os))
    64| message("  Events (deaths): ", sum(os$OS_event, na.rm = TRUE))
    65| 
    66| # Extract stage and age from long-format clinical_raw
    67| pivot_clin <- function(df, attr_id) {
    68|   df %>%
    69|     dplyr::filter(clinicalAttributeId == attr_id) %>%
    70|     dplyr::select(patientId, value) %>%
    71|     dplyr::distinct(patientId, .keep_all = TRUE)
    72| }
    73| 
    74| stage_df <- pivot_clin(clin_raw, "AJCC_PATHOLOGIC_TUMOR_STAGE")
    75| if (nrow(stage_df) == 0)
    76|   stage_df <- pivot_clin(clin_raw, "STAGE")
    77| if (nrow(stage_df) == 0)
    78|   stage_df <- pivot_clin(clin_raw, "TUMOR_STAGE")
    79| 
    80| age_df <- pivot_clin(clin_raw, "AGE")
    81| 
    82| message("  Stage records: ", nrow(stage_df))
    83| if (nrow(stage_df) > 0) {
    84|   message("  Stage values (sample): ",
    85|           paste(head(stage_df$value, 8), collapse = ", "))
    86| }
    87| 
    88| # Merge
    89| clin <- os %>%
    90|   dplyr::left_join(stage_df %>% dplyr::rename(stage_raw = value),
    91|                    by = "patientId") %>%
    92|   dplyr::left_join(age_df %>% dplyr::rename(age = value),
    93|                    by = "patientId") %>%
    94|   dplyr::mutate(age = suppressWarnings(as.numeric(age)))
    95| 
    96| # Numeric stage
    97| clin$stage_n <- dplyr::case_when(
    98|   grepl("^I$|^Stage I$|IA|IB|1A|1B",    clin$stage_raw, ignore.case=TRUE) ~ 1,
    99|   grepl("^II$|^Stage II$|IIA|IIB|2A|2B", clin$stage_raw, ignore.case=TRUE) ~ 2,
   100|   grepl("III|3",                           clin$stage_raw, ignore.case=TRUE) ~ 3,
   101|   grepl("IV|4",                            clin$stage_raw, ignore.case=TRUE) ~ 4,
   102|   TRUE ~ NA_real_
   103| )
   104| 
   105| message("  Final clinical n: ", nrow(clin))
   106| message("  Stage distribution:")
   107| print(table(clin$stage_raw, useNA = "ifany"))
   108| 
   109| ##############################################################################
   110| # 3. Align expression to clinical samples
   111| ##############################################################################
   112| message("=== Step 3: Align samples ===")
   113| 
   114| # Expression columns are patient IDs (C3L-XXXXX / C3N-XXXXX)
   115| expr_mat    <- as.matrix(expr)
   116| common_ids  <- intersect(clin$patientId, colnames(expr_mat))
   117| message("  Common samples: ", length(common_ids))
   118| 
   119| clin_filt   <- clin[clin$patientId %in% common_ids, ]
   120| expr_filt   <- expr_mat[, clin_filt$patientId, drop = FALSE]
   121| 
   122| message("  Final n: ", nrow(clin_filt), "  Events: ", sum(clin_filt$OS_event))
   123| 
   124| # Verify key genes
   125| for (g in c("TIMP1", "PDPN")) {

